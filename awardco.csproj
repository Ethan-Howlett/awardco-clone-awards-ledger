<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.0" />
  </ItemGroup>

  <!-- The test project lives inside this folder, so keep its files out of the main app's build. -->
  <ItemGroup>
    <Compile Remove="awardco.Tests/**" />
    <Content Remove="awardco.Tests/**" />
    <None Remove="awardco.Tests/**" />
  </ItemGroup>

</Project>
